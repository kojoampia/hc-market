<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Consumer idempotency keys. Hand-written, not generated from JDL - it is infrastructure.
        Regenerating payout from JDL rewrites master.xml and DROPS the include for this file.
    -->
    <changeSet id="20260824210000-1" author="healthconnect">
        <createTable tableName="processed_event">
            <column name="event_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="processed_at" type="${datetimeType}"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
