/**
 * HealthConnect Marketplace — catalog service.
 *
 * Owns categories, professionals, their service offerings, availability and reviews.
 * Spec: docs/healthconnect-marketplace.md §5.1. Decisions: docs/decisions.md.
 *
 * Import with:
 *   jhipster jdl jdl/catalog.jdl
 *
 * THE RULE THIS FILE EXISTS TO ENFORCE
 * ------------------------------------
 * `Professional` has no `rating` and no `reviewCount` column, and must never acquire one.
 * Both are derived from `Review` by the `professional_rating` view, mapped by an @Immutable
 * entity and served on the professional DTO. A rating that disagrees with its reviews is a bug
 * the schema should make impossible. The view is not expressible in JDL — it is added as a
 * hand-written Liquibase changelog after generation.
 *
 * `Category` likewise has no `specialities` column even though the Browse filter needs the list
 * and the seed file carries one: it is DISTINCT over the professionals in that category.
 */

application {
  config {
    baseName healthconnectCatalog
    applicationType microservice
    packageName net.jojoaddison
    serverPort 8081
    databaseType sql
    prodDatabaseType postgresql
    devDatabaseType postgresql
    authenticationType jwt
    messageBroker kafka
    serviceDiscoveryType consul
    buildTool maven
    skipUserManagement true
    clientFramework no
    enableTranslation false
    testFrameworks [cucumber]
  }
  entities Category, Professional, ServiceOffering, AvailabilitySlot, AvailabilityRule, AvailabilityOverride, Review, Credential, Highlight, Favourite, VerificationReview
}

// ===========================================================================
// Enumerations
// ===========================================================================

/** How a session is delivered. The seed carries these as prose ("In person"); the extractor
 *  emits the enum name, so nothing downstream has to translate display text. */
enum DeliveryMode {
  IN_PERSON,
  ONLINE,
  HOME_VISIT
}

/** ISO-8601 order, and the names match java.time.DayOfWeek so the mapping cannot drift. */
enum Weekday {
  MONDAY,
  TUESDAY,
  WEDNESDAY,
  THURSDAY,
  FRIDAY,
  SATURDAY,
  SUNDAY
}

/** Where a professional sits in the trust chain. The prototype had only a boolean `verified`;
 *  four states exist because suspension has to be distinguishable from never-verified. */
enum VerificationState {
  UNVERIFIED,
  PENDING,
  VERIFIED,
  SUSPENDED
}

// ===========================================================================
// Entities
// ===========================================================================

entity Category {
  code String required unique maxlength(32)
  name String required
  blurb String maxlength(400)
  icon String
  sortOrder Integer required
}

entity Professional {
  reference String required unique          // p1 … p18 in the seed
  userLogin String required unique          // links to the gateway account
  displayName String required
  initials String maxlength(4)
  headline String required maxlength(160)
  speciality String required
  city String required
  countryCode String required maxlength(2)
  yearsPractising Integer min(0)
  verification VerificationState required
  insured Boolean required
  policeClearance Boolean required
  responseMinutes Integer
  rebookRatePct Integer min(0) max(100)
  bio TextBlob
  languages String                          // comma-separated, small and stable
  deliveryModes String                      // comma-separated DeliveryMode names
  avatarGradientFrom String maxlength(7)     // "#0D3058" — the prototype's duotone avatar
  avatarGradientTo String maxlength(7)
  publishedAt Instant
  // ADDED, decisions.md D21/D29. The zone the professional's WALL CLOCK belongs to, and the reason
  // it is stored rather than assumed: Ghana is UTC+0 all year with no daylight saving, so the
  // implicit model is genuinely correct today — it is simply not legible. Nothing in the schema
  // said which zone an availability slot's 07:00 was 07:00 in.
  //
  // The PROFESSIONAL's zone is authoritative because that is where the service is physically
  // delivered. Appointments are NOT converted to instants: if a zone's rules ever change, the 7 a.m.
  // session must stay at 7 a.m. rather than silently becoming 6 a.m.
  zoneId String required maxlength(64)       // an IANA name, e.g. Africa/Accra
}

/**
 * ADDED, decisions.md D16/D29. Who verified this professional, when, and on what evidence.
 *
 * `Professional.verification` is a bare enum shown publicly beside somebody's name, and until this
 * existed there was no record of how it got its value. For a trust signal that is thin: nobody could
 * answer "who decided this, and what did they see" — not for a complaint, not for an audit, not for
 * the professional asking why they were rejected.
 *
 * APPEND-ONLY. There is no endpoint to edit or delete a review, for the same reason there is none to
 * delete a Review: a history that can be rewritten answers none of the questions it exists for. A
 * decision that was wrong is corrected by appending the new one.
 *
 * Note the tension with "derived, never stored": `Professional.verification` is now strictly the
 * projection of the latest row here. It stays a column because `verifiedOnly` filters Browse on it
 * and because all 18 seeded professionals arrive with a state and no review history — the prototype
 * has no such data to extract. Both are written in ONE transaction by the desk resource, which is
 * what stops them drifting.
 *
 * There is no evidence STORE. `evidenceRef` names a document held somewhere else — a case number, a
 * file reference in the back-office. Document storage is unbuilt and out of scope here (D16).
 */
entity VerificationReview {
  reference String required unique
  decision VerificationState required
  reviewer String required                   // the login of the person who decided, from the JWT
  reviewedAt Instant required
  evidenceRef String maxlength(200)          // what they looked at, held elsewhere
  note String maxlength(1000)
}

entity ServiceOffering {
  reference String required unique
  name String required
  durationMinutes Integer min(0)
  priceMinor Long required min(0)           // pesewas — never a float
  currency String required maxlength(3)
  description String maxlength(500)
  active Boolean required
  sortOrder Integer
}

/**
 * The bookable unit, and it stays a materialised ROW rather than something computed at read time
 * (decisions.md D20). `taken` needs a row to lock: two customers booking the same 07:00 must collide
 * on a unique constraint over (professional, date, time), and with availability computed on demand
 * there is nothing to contend on and the double booking is silent. The same reasoning as the unique
 * (customer_login, professional_ref) on Favourite.
 *
 * `slotTime` was `String maxlength(5)`. It sorted correctly only by the accident of zero-padded
 * 24-hour text and accepted "7:00" and "25:99" — see decisions.md D20 and D26.
 */
entity AvailabilitySlot {
  slotDate LocalDate required
  slotTime LocalTime required
  taken Boolean required
}

/**
 * How a professional actually thinks about availability: "Tuesdays and Thursdays, 07:00 to 11:00,
 * hourly". Slots are generated from these forward a fixed horizon; the rule is what a professional
 * edits, the slot is what a customer books.
 *
 * `weekday` names match `java.time.DayOfWeek` exactly so the mapping is `DayOfWeek.valueOf(name())`
 * rather than a lookup table that can drift.
 */
entity AvailabilityRule {
  weekday Weekday required
  startTime LocalTime required
  endTime LocalTime required
  slotMinutes Integer required min(5) max(480)
  validFrom LocalDate required
  validUntil LocalDate                      // null = open-ended
  active Boolean required
}

/**
 * A single day that departs from the rules — a holiday, or a day with different hours.
 *
 * Named `AvailabilityOverride`, NOT `AvailabilityException`: a JPA entity whose name ends in
 * `Exception` reads as a `Throwable` everywhere it appears, and this repository has already paid
 * that tax once by renaming `Thread` to `Conversation` in messaging. `closed = true` means no slots
 * that day; `closed = false` with a window means those hours instead of the rules'.
 */
entity AvailabilityOverride {
  overrideDate LocalDate required
  closed Boolean required
  startTime LocalTime
  endTime LocalTime
  note String maxlength(200)
}

/**
 * `customerLogin` is spec §9's missing half: it requires a review to be backed by a COMPLETED
 * booking "for that customer", but the specified entity carried no customer identity to match
 * against. It is never serialised to the public DTO — `authorName` and `authorInitials` are what
 * a reader sees.
 *
 * `bookingReference` is unique, which is what makes "one review per booking" a schema guarantee
 * rather than a service-layer hope.
 */
entity Review {
  reference String required unique
  customerLogin String required
  authorName String required
  authorInitials String maxlength(4)
  stars Integer required min(1) max(5)
  publishedOn LocalDate required
  body TextBlob required
  professionalReply TextBlob
  bookingReference String required unique   // proves the review is earned
}

/**
 * Credentials and highlights are child rows, not comma-separated strings, because the data
 * defeats that idiom: "BSc Nutrition & Dietetics, University of Ghana" contains the separator.
 * `languages` and `deliveryModes` stay comma-separated — those values are single words.
 */
entity Credential {
  label String required maxlength(160)
  sortOrder Integer required
}

entity Highlight {
  label String required maxlength(160)
  sortOrder Integer required
}

/**
 * The customer's Saved list.
 *
 * Deliberately NOT a relationship to Professional. A favourite is keyed by the professional's
 * business reference and the customer's login, both of which are stable and meaningful outside this
 * service; a foreign key would mean a customer's saved list could not survive a professional being
 * removed from the catalogue, and "the person I saved is gone" is a thing the screen should be able
 * to say rather than a row that vanishes.
 *
 * `customerLogin` + `professionalRef` is unique: saving twice is the same as saving once, and the
 * schema is what makes that true rather than a check in the resource.
 */
entity Favourite {
  customerLogin String required
  professionalRef String required
  addedAt Instant required
}

/**
 * Relationship sides are named in the SINGULAR. JHipster pluralises the generated field itself, so
 * `Professional{services}` produces `Set<ServiceOffering> serviceses` with a `getServiceses()`
 * accessor — double-pluralised and permanent. `Professional{service}` produces `services`.
 */
relationship OneToMany {
  Category{professional} to Professional{category required}
  Professional{service} to ServiceOffering{professional required}
  Professional{availability} to AvailabilitySlot{professional required}
  Professional{rule} to AvailabilityRule{professional required}
  Professional{override} to AvailabilityOverride{professional required}
  Professional{review} to Review{professional required}
  Professional{credential} to Credential{professional required}
  Professional{highlight} to Highlight{professional required}
  Professional{verificationReview} to VerificationReview{professional required}
}

service Category, Professional, ServiceOffering, AvailabilitySlot, AvailabilityRule, AvailabilityOverride, Review with serviceClass
dto Category, Professional, ServiceOffering, AvailabilitySlot, AvailabilityRule, AvailabilityOverride, Review with mapstruct
paginate Professional, Review with pagination
filter Professional

microservice * with healthconnectCatalog
