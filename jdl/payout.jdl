/**
 * HealthConnect Marketplace — payout service.
 *
 * Brokerage configuration, the earnings ledger and monthly payouts.
 * Spec: docs/healthconnect-marketplace.md §5.4.
 *
 * Import with:
 *   jhipster jdl jdl/payout.jdl
 *
 * THE RULE THIS FILE EXISTS TO ENFORCE
 * ------------------------------------
 * There is no `professional.total_earnings` column, and there must never be one. Monthly earnings,
 * gross-vs-net, sessions by service, sessions by format, lifetime totals, average session value and
 * repeat rate are all SQL aggregates over Ledger joined to Booking. Month-to-date comparisons use
 * the SAME SLICE OF DAYS in the previous month, so a partial month never reads as a collapse.
 *
 * BrokerageConfig is versioned by `effectiveFrom` rather than overwritten, so changing the
 * commission rate never rewrites history: a booking is priced against the config in force when it
 * completed. The prototype's hard-coded COMMISSION = 0.12 could not express that.
 */

application {
  config {
    baseName healthconnectPayout
    applicationType microservice
    packageName net.jojoaddison
    serverPort 8084
    databaseType sql
    prodDatabaseType postgresql
    devDatabaseType postgresql
    authenticationType jwt
    messageBroker kafka
    serviceDiscoveryType consul
    buildTool maven
    skipUserManagement true
    clientFramework no
    enableTranslation false
    testFrameworks [cucumber]
  }
  entities BrokerageConfig, Ledger, Payout
}

// ===========================================================================
// Enumerations
// ===========================================================================

enum PayoutStatus {
  OPEN,
  IN_PROGRESS,
  PAID,
  FAILED
}

/** Mirrors the booking service's enum. Duplicated rather than shared because each service owns its
 *  own schema and must be deployable without the others. */
enum DeliveryMode {
  IN_PERSON,
  ONLINE,
  HOME_VISIT
}

// ===========================================================================
// Entities
// ===========================================================================

entity BrokerageConfig {
  commissionRate BigDecimal required min(0) max(1)   // 0.12
  payoutLagDays Integer required                     // 3
  freeCancellationHours Integer required             // 24
  lateCancellationPct BigDecimal required            // 0.50
  currency String required maxlength(3)
  effectiveFrom Instant required
}

/**
 * One row per completed or late-cancelled booking. `bookingReference` is unique, so a replayed
 * booking.completed event cannot double-credit a professional.
 *
 * AMENDED, for the same reason `Review` gained `customerLogin` (decisions.md D8): the spec requires
 * `/api/pro/**` to resolve the professional from the token and refuse anything that is not the
 * caller's, but the specified entity carried only `professionalRef` — nothing a JWT subject can be
 * matched against without asking the catalog service. `professionalLogin` makes the ownership check
 * local to one row.
 *
 * `deliveryMode` is denormalised here on purpose, exactly as `grossMinor` already is. The earnings
 * screen breaks sessions down by format, and a ledger row must keep saying what it said when it was
 * written even if the booking is later corrected — the same rule that stops a receipt changing when
 * a price is edited.
 *
 * The money columns are all stored rather than derived, and that is not a contradiction of the
 * derived-not-stored rule: commission depends on the BrokerageConfig *in force when the booking
 * completed*, so recomputing it later from today's rate would rewrite history. What must never be
 * stored is a total ACROSS rows — there is no professional.total_earnings anywhere.
 */
entity Ledger {
  bookingReference String required unique
  professionalRef String required
  professionalLogin String required
  grossMinor Long required
  commissionMinor Long required
  netMinor Long required
  currency String required maxlength(3)
  deliveryMode DeliveryMode required
  serviceRef String
  serviceName String
  earnedOn LocalDate required
}

entity Payout {
  reference String required unique    // PAY-202607-AM
  professionalRef String required
  periodStart LocalDate required
  periodEnd LocalDate required
  grossMinor Long required
  commissionMinor Long required
  netMinor Long required
  currency String required maxlength(3)
  status PayoutStatus required
  settledOn LocalDate
  bankReference String
}

relationship ManyToOne {
  Ledger{payout} to Payout{entries}
}

service BrokerageConfig, Ledger, Payout with serviceClass
dto BrokerageConfig, Ledger, Payout with mapstruct
paginate Ledger, Payout with pagination
filter Ledger

microservice * with healthconnectPayout
