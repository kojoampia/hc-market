<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Indexes for the columns the erasure sweeps and the customer's own screens filter by
        - decisions.md D34. Hand-written; regenerating booking from JDL rewrites master.xml and DROPS
        this include, at which point every one of these becomes a sequential scan again, silently.

        booking.customer_login is not only the erasure's entry point: it also serves "my bookings",
        which is four calls per page load in the prototype's four tabs.

        No index on outbox_event.aggregate_ref beyond this one - the erasure looks rows up by it, and
        the publisher's own hot path already has idx_outbox_unsent.
    -->
    <changeSet id="20260901120000-1" author="healthconnect">
        <createIndex indexName="idx_booking_customer_login" tableName="booking">
            <column name="customer_login"/>
        </createIndex>
        <createIndex indexName="idx_booking_status_change_actor" tableName="booking_status_change">
            <column name="actor"/>
        </createIndex>
        <createIndex indexName="idx_dispute_raised_by_login" tableName="dispute">
            <column name="raised_by_login"/>
        </createIndex>
        <createIndex indexName="idx_dispute_status_change_actor" tableName="dispute_status_change">
            <column name="actor"/>
        </createIndex>
        <createIndex indexName="idx_outbox_aggregate_ref" tableName="outbox_event">
            <column name="aggregate_ref"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
