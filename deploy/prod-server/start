#!/bin/bash
# Brings the whole hc-market estate up on webserver from what is already on disk.
#
#   ssh webserver
#   cd /srv/healthconnect && ./start
#
# THIS IS NOT A DEPLOY. It changes no tag, pulls no application image and writes no .env. It is the
# after-a-reboot / after-a-docker-restart path: bring back exactly what was running.
#
# A deploy is ../deploy-prod.sh, run from a workstation, and it owns docker-compose.yml and .env.
# Two things that both roll the application stack is how a stack ends up running something nobody
# chose — so this one deliberately cannot choose. If .env is absent it stops and says to deploy.
#
# --- The two projects, in order ------------------------------------------------------------------
#
#   hc-market-data   data-compose.yml    the five stores.  Installed once, does not roll.
#   healthconnect    docker-compose.yml  the five apps.    Uploaded by every deploy.
#
# The stores come up first and are waited for, because the applications run Liquibase at startup
# against a database that has to be there. `depends_on` cannot express this: they are separate
# compose projects, so compose has no idea the other one exists — which is the same reason
# deploy-prod.sh checks the shared networks by hand rather than declaring a dependency on Kafka.
#
# --- Why both --env-file arguments, every time ---------------------------------------------------
#
# The `:?` checks in both compose files are evaluated at INTERPOLATION time, so pull, up, ps and exec
# all need the same environment or none of them work. Naming any --env-file also stops compose
# auto-loading .env, so both have to be listed. The later file wins, and secrets.env is second on
# purpose: a generated .env must never be able to override a secret.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

SECRETS_FILE="${SECRETS_FILE:-secrets.env}"
DATA_COMPOSE="${DATA_COMPOSE:-data-compose.yml}"
APP_COMPOSE="${APP_COMPOSE:-docker-compose.yml}"
# How many stores data-compose.yml declares. Asserted rather than assumed — see the health wait.
EXPECTED_STORES="${EXPECTED_STORES:-5}"

if [[ ! -s "$SECRETS_FILE" ]]; then
  echo "error: $PWD/$SECRETS_FILE is missing or empty." >&2
  echo "       It holds this estate's long-lived secrets — JWT_BASE64_SECRET, HC_PRIVACY_PEPPER" >&2
  echo "       (decisions.md D35), the five database credentials and the gateway's Mongo URI." >&2
  echo "       It is created once, by hand, and no deploy rewrites it. See secrets.env.example in" >&2
  echo "       the repository, and the README's 'Creating secrets.env'." >&2
  exit 1
fi

if [[ ! -f "$DATA_COMPOSE" ]]; then
  echo "error: $PWD/$DATA_COMPOSE is missing — the data tier has never been installed here." >&2
  echo "       Copy deploy/prod-server/compose.yml to $PWD/$DATA_COMPOSE and run ./infra.sh first." >&2
  exit 1
fi

echo "==> data tier ($DATA_COMPOSE)"
# No `pull`. These are postgres:17 and mongo:8, floating minors — pulling here would silently upgrade
# a database engine during what an operator thinks is a restart. Upgrading them is a maintenance
# window with a dump in front of it, not a side effect of ./start.
docker compose --env-file "$SECRETS_FILE" -f "$DATA_COMPOSE" up -d

echo "==> waiting for the stores to report healthy"
# --- `ps -a`, AND A COUNT, BECAUSE THE ABSENCE OF A STORE IS NOT THE ABSENCE OF A PROBLEM ---------
#
# THIS GATE PASSED WHEN THE STORES WERE GONE. `docker compose ps` lists only RUNNING containers —
# `-a` is needed for stopped ones — so a store that EXITS is not in the output at all: a corrupt
# volume, or a Mongo datadir whose credentials no longer match (the rotation trap in README.md's
# "Rotating a credential", which is the likeliest way this happens). Filtering that output for
# services that are not healthy then found nothing, printed "all five stores healthy", and started
# the five applications against dead databases. If all five had exited, the output was empty and the
# gate was unanimous about it.
#
# Waiting for this is the script's entire reason to exist, so it now asserts a positive: FIVE
# services, all healthy. `-a` makes an exited store visible (State `exited`, Health empty, so it is
# reported rather than skipped) and the count catches the case -a cannot — a container removed
# altogether, which appears in no listing of any kind.
waited=0
while :; do
  status="$(docker compose --env-file "$SECRETS_FILE" -f "$DATA_COMPOSE" ps -a \
              --format '{{.Service}} {{.State}} {{.Health}}')"
  seen="$(printf '%s\n' "$status" | grep -c '[^[:space:]]' || true)"
  notready="$(printf '%s\n' "$status" | awk '$3 != "healthy" {print $1"  ("$2" "$3")"}')"
  if (( seen == EXPECTED_STORES )) && [[ -z "$notready" ]]; then
    echo "    all $EXPECTED_STORES stores healthy"
    break
  fi
  (( waited += 5 ))
  if (( waited >= 180 )); then
    echo "error: the data tier is not ready after ${waited}s — $seen of $EXPECTED_STORES services present." >&2
    [[ -n "$notready" ]] && echo "$notready" | sed 's/^/       /' >&2
    if (( seen != EXPECTED_STORES )); then
      echo "       $((EXPECTED_STORES - seen)) service(s) have no container at all, which is not a" >&2
      echo "       slow start — check that $PWD/$DATA_COMPOSE is the whole data tier." >&2
    fi
    echo "       The applications were NOT started. Look at the store logs before going further:" >&2
    echo "         docker compose --env-file $SECRETS_FILE -f $DATA_COMPOSE logs --tail=50" >&2
    exit 1
  fi
  sleep 5
done

if [[ ! -f "$APP_COMPOSE" || ! -f .env ]]; then
  echo ""
  echo "The data tier is up. The application stack is NOT — $PWD/$APP_COMPOSE or $PWD/.env is absent,"
  echo "which means no deploy has ever landed here. Both are written by deploy-prod.sh:"
  echo ""
  echo "    ./deploy/deploy-prod.sh --channel github --tag <full-40-char-sha>"
  echo ""
  echo "run from a workstation, not from this host. See deploy/prod-server/README.md."
  exit 0
fi

echo "==> application stack ($APP_COMPOSE, tag $(grep -m1 '^HC_TAG=' .env | cut -d= -f2-))"
# --remove-orphans is safe because docker-compose.prod.yml pins `name: healthconnect`, so it can only
# ever touch this project's own containers. NOT --force-recreate: this is a restart, and recreating
# five JVMs that are already running correctly is a two-minute outage for nothing.
#
# AND NO `pull`. There was one, and it contradicted this file's own header three lines from the top
# ("pulls no application image"). Harmless while every tag is a commit SHA and therefore immutable —
# and README.md documents the case that is not: `deploy-prod.sh --build` "overwrites what CI
# published at that tag", after which a post-reboot ./start silently fetched different bytes for the
# same tag and this script chose something nobody chose. Bringing back exactly what was running is
# the whole contract.
#
# `up -d` still fetches an image that is not on this host at all — the default pull policy is
# `missing` — which is the one case where these bytes come from a registry, and it is unavoidable
# without refusing to start. That case is a pruned image rather than a re-pushed tag, so it fetches
# the tag it already had.
docker compose --env-file .env --env-file "$SECRETS_FILE" -f "$APP_COMPOSE" up -d --remove-orphans

echo ""
echo "start done."
docker compose --env-file "$SECRETS_FILE" -f "$DATA_COMPOSE" ps
docker compose --env-file .env --env-file "$SECRETS_FILE" -f "$APP_COMPOSE" ps
echo ""
echo "The five JVMs take ~2 minutes to report ready. Verify from a workstation with:"
echo "    ./deploy/deploy-prod.sh --tag \$(grep -m1 '^HC_TAG=' $PWD/.env | cut -d= -f2-) --dry-run"
echo "and, once they are up, the public check in deploy/prod-server/README.md § Verifying."
