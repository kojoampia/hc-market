# HealthConnect Marketplace — repository-level ignores.
#
# Each app carries its own generated .gitignore covering /target/, node_modules/ and the usual
# JHipster output; git applies those nested files, so this one only handles what spans the repo.

# Build output, belt and braces — the five target/ directories are ~260 MB each.
*/target/
target/

# Local environment. deploy-dev.sh and deploy-prod.sh both read secrets from the environment;
# JWT_BASE64_SECRET in particular must never be committed — one key is shared across the estate.
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# The production host's long-lived values (decisions.md D35, D49). `.env.*` above does NOT cover this
# name — that pattern matches files literally called `.env.something` — and the file holds the
# signing key, the erasure pepper and five database passwords. It is created on the server, by hand,
# and should never exist in a checkout at all; this is here for the case where somebody copies one
# back to look at it.
secrets.env
**/secrets.env
!deploy/prod-server/secrets.env.example

# Leftover output from running the estate
*.log
!deploy/**/*.log

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store

# Node, if any tooling lands here later
node_modules/
